# Supabase (PostgreSQL 15 + Auth + Storage — Plan Gratuito us-east-1)
# Si se dejan vacíos, la aplicación opera automáticamente en modo Motor Local Transaccional
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Herramientas de demostración del parcial (CP-002 rollback, CP-003 timer acelerado, CP-005 carga escenarios)
NEXT_PUBLIC_ENABLE_DEMO_TOOLS=true
