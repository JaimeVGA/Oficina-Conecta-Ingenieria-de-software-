# ==========================================
# Oficina Conecta - Git Ignore Specification
# Next.js 14+ / TypeScript / Supabase / Node.js
# ==========================================

# --- Dependencias de Node ---
node_modules/
.pnpm-store/
.pnp
.pnp.js

# --- Compilación y Salidas de Next.js / Webpack ---
.next/
out/
build/
dist/

# --- Caché y Estado de TypeScript / Linters ---
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/

# --- Variables de Entorno y Secretos ---
# Proteger credenciales, tokens y llaves privadas
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Permitir explícitamente el archivo de plantilla para el equipo
!.env.example

# --- Base de Datos Local y Storage de Runtime (Oficina Conecta) ---
# Persistencia local mock ACID y archivos temporales subidos
.oficina-conecta-local-db.json
.oficina-conecta-storage/
*.sqlite
*.sqlite3
*.db

# --- Supabase Local ---
.supabase/

# --- Pruebas y Cobertura de Código ---
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/

# --- Logs y Diagnóstico ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editores e IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Archivos del Sistema Operativo ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

.vercel
.env*
